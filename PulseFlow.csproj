<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>PulseFlow</PackageId>
        <AssemblyName>PulseFlow</AssemblyName>
        <RootNamespace>PulseFlow</RootNamespace>
        <Version>2.0.0-preview.1</Version>
        <Authors>Andrés Mariño</Authors>
        <Company>Andrés Mariño</Company>
        <Description>CQRS mediator for .NET 8, 9 and 10 with command/query-aware pipelines, typed Result and Error, ValueTask end to end, validation, notifications and DDD primitives (Entity, AggregateRoot, ValueObject, Domain Events).</Description>
        <PackageTags>clean-architecture;ddd;cqrs;mediator-pattern;result;kernel;architecture;domain-driven-design;mediator</PackageTags>
        <RepositoryUrl>https://github.com/ffamaximus/clean-architecture-kernel-core</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/ffamaximus/clean-architecture-kernel-core</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>1591</NoWarn>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- tests/ lives under this folder: keep its sources out of the library build. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>
            2.0.0: ICommand&lt;TResponse&gt;, typed Error and richer Result, command-only and query-only pipeline behaviors, ValueTask end to end, async FluentValidation, sequential Publish by default. Breaking changes: see CHANGELOG.md.
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation" Version="12.1.1" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8" />
    </ItemGroup>

    <ItemGroup>
        <None Include="icon.png" Pack="true" PackagePath=""/>
        <None Include=".\README.md" Pack="true" PackagePath=""/>
    </ItemGroup>

</Project>
