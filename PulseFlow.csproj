<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>PulseFlow</PackageId>
        <AssemblyName>PulseFlow</AssemblyName>
        <RootNamespace>PulseFlow</RootNamespace>
        <Description>CQRS mediator for .NET 8, 9 and 10 with command/query-aware pipelines, typed Result and Error, ValueTask end to end, validation, notifications and DDD primitives (Entity, AggregateRoot, ValueObject, Domain Events).</Description>
        <PackageTags>clean-architecture;ddd;cqrs;mediator-pattern;result;kernel;architecture;domain-driven-design;mediator</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>1591</NoWarn>
        <!-- tests/, integrations/ and benchmarks/ live under this folder: keep their sources out of the core library. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;integrations/**;benchmarks/**</DefaultItemExcludes>
        <PackageReleaseNotes>
            2.0.0: ICommand&lt;TResponse&gt;, typed Error and richer Result (with JSON support), command-only and query-only pipeline behaviors, ValueTask end to end, sequential Publish by default. Only Microsoft.Extensions.*.Abstractions dependencies; FluentValidation moved to the PulseFlow.FluentValidation package. Breaking changes: see CHANGELOG.md.
        </PackageReleaseNotes>
    </PropertyGroup>

    <!-- Only the abstractions, at the lowest version of each target framework: the application decides the actual version. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <None Include="icon.png" Pack="true" PackagePath=""/>
        <None Include=".\README.md" Pack="true" PackagePath=""/>
    </ItemGroup>

</Project>
