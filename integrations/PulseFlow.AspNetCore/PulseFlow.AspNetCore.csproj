<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>PulseFlow.AspNetCore</PackageId>
        <AssemblyName>PulseFlow.AspNetCore</AssemblyName>
        <RootNamespace>PulseFlow.AspNetCore</RootNamespace>
        <Description>ASP.NET Core integration for PulseFlow: map commands and queries to minimal API endpoints in one line and turn Result / Error into HTTP responses and RFC 9457 ProblemDetails automatically.</Description>
        <PackageTags>pulseflow;aspnetcore;minimal-api;problemdetails;cqrs;mediator;result</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\PulseFlow.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\icon.png" Pack="true" PackagePath="" Visible="false" />
        <None Include="README.md" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>
