<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageId>PulseFlow.FluentValidation</PackageId>
        <AssemblyName>PulseFlow.FluentValidation</AssemblyName>
        <RootNamespace>PulseFlow</RootNamespace>
        <Description>FluentValidation integration for PulseFlow: runs your FluentValidation validators (including async rules) before every command and query and returns a typed Validation error instead of throwing.</Description>
        <PackageTags>pulseflow;fluentvalidation;validation;cqrs;mediator;pipeline</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentValidation" Version="12.1.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\PulseFlow.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\icon.png" Pack="true" PackagePath="" Visible="false" />
        <None Include="README.md" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>
